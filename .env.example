# DeepSeek via Anthropic-compatible API
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Model: deepseek-v4-pro (旗舰) or deepseek-v4-flash (快速)
VOIDX_DEFAULT_MODEL=deepseek-v4-pro
VOIDX_DEFAULT_PROVIDER=deepseek

# --- or native Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# VOIDX_DEFAULT_MODEL=claude-sonnet-4-6
# VOIDX_DEFAULT_PROVIDER=anthropic

# --- or OpenAI ---
# OPENAI_API_KEY=sk-xxx
# VOIDX_DEFAULT_MODEL=gpt-4o
# VOIDX_DEFAULT_PROVIDER=openai
