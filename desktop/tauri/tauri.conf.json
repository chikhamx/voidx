{
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../frontend/dist"
  },
  "version": "3.8.0",
  "bundle": {
    "active": true,
    "resources": {"resources/backend/": "backend/"},
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "dmg",
      "app",
      "msi"
    ]
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "minWidth": 800,
        "width": 1200,
        "minHeight": 600,
        "title": "",
        "height": 820,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "identifier": "com.voidx.desktop",
  "productName": "voidx"
}
