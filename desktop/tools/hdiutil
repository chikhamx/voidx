#!/usr/bin/env bash

set -u

if [ "${1:-}" != "detach" ]; then
  exec /usr/bin/hdiutil "$@"
fi

status=1
for attempt in 1 2 3 4; do
  /usr/bin/hdiutil "$@"
  status=$?
  [ "$status" -eq 0 ] && exit 0
  [ "$status" -eq 2 ] || [ "$status" -eq 16 ] || exit "$status"
  sleep "$attempt"
done

exit "$status"
